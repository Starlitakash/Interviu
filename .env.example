# Primary LLM Configuration (Qwen 3 / Qwen 2.5 Coder via Groq)
GROQ_API_KEY=your_groq_api_key_here
STITCH_API_KEY=your_stitch_api_key_here

PRIMARY_LLM_PROVIDER=groq
